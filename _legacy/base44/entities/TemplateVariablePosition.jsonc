{
  "name": "TemplateVariablePosition",
  "type": "object",
  "properties": {
    "template_id": {
      "type": "string",
      "description": "Reference to Template entity"
    },
    "variable_key": {
      "type": "string",
      "enum": [
        "PLATE_COMBINED_STRING",
        "ISSUE_DATE",
        "EXPIRY_DATE",
        "COUPON_ID"
      ],
      "description": "Variable identifier"
    },
    "x_coordinate": {
      "type": "number",
      "description": "X position on image (in pixels)"
    },
    "y_coordinate": {
      "type": "number",
      "description": "Y position on image (in pixels)"
    },
    "font_size": {
      "type": "number",
      "default": 12,
      "description": "Font size for the variable text"
    },
    "default_value": {
      "type": "string",
      "description": "Default value to pre-fill when creating coupons"
    }
  },
  "required": [
    "template_id",
    "variable_key",
    "x_coordinate",
    "y_coordinate"
  ]
}